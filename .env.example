# API Configuration
API_PORT=3001
API_URL=http://localhost:3001
NODE_ENV=development

# Database Configuration (when using docker-compose)
DATABASE_URL=postgresql://taskuser:taskpass@db:5432/taskdb

# Redis Configuration (for Bull job queue)
REDIS_URL=redis://redis:6379

# Job Queue Configuration
JOB_CHECK_INTERVAL_MS=60000
RECURRENCE_NOTIFICATION_INTERVALS=300000,600000,900000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
